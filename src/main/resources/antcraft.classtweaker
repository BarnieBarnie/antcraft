classTweaker	v1	official
# RegionPlan.load builds one palette of a multi-palette structure; the template keeps them private.
accessible	field	net/minecraft/world/level/levelgen/structure/templatesystem/StructureTemplate	palettes	Ljava/util/List;
# BotHands.strike brings a weapon equipped on the tick of a blow into the bot's attributes before it lands (#425).
accessible	method	net/minecraft/world/entity/LivingEntity	detectEquipmentUpdates	()V
# smelt puts the next fuel in on the fire's last tick, so the furnace relights without losing progress (#512).
accessible	field	net/minecraft/world/level/block/entity/AbstractFurnaceBlockEntity	litTimeRemaining	I
# shoot fires a bot's bow or crossbow as the item would for a player, with the arrows the bot carries (#707).
accessible	method	net/minecraft/world/item/ProjectileWeaponItem	shoot	(Lnet/minecraft/server/level/ServerLevel;Lnet/minecraft/world/entity/LivingEntity;Lnet/minecraft/world/InteractionHand;Lnet/minecraft/world/item/ItemStack;Ljava/util/List;FFZLnet/minecraft/world/entity/LivingEntity;)V
accessible	method	net/minecraft/world/item/ProjectileWeaponItem	draw	(Lnet/minecraft/world/item/ItemStack;Lnet/minecraft/world/item/ItemStack;Lnet/minecraft/world/entity/LivingEntity;)Ljava/util/List;
# pick_up takes back an arrow stuck in a block that a player could pick up (#720).
accessible	method	net/minecraft/world/entity/projectile/arrow/AbstractArrow	isInGround	()Z
# Animals follow a bot holding their food as TemptGoal follows a player, at its speed (BotTemptGoal, #843).
accessible	field	net/minecraft/world/entity/ai/goal/TemptGoal	speedModifier	D
